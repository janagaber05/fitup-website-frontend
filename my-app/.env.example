# Create React App — only variables prefixed with REACT_APP_ are exposed to the browser bundle.
# Copy to .env.local (gitignored by CRA) and fill with your Supabase project values.
# Use the anon (public) key — never the service_role key in the frontend.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
